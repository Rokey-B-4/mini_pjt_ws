        <mxCell id="f_lbl_r" value="② 온보드 인식 + cmd_vel 추적 (PC2)" style="text;html=1;fontStyle=1;fontColor=#cc0000;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="10" width="260" height="20" as="geometry"/></mxCell>
      </root>
