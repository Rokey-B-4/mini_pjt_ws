<mxfile host="app.diagrams.net" agent="mini_pjt" version="24.0.0">
  <diagram name="1. 플로우차트" id="flow">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Left column: webcam + mission (PC1) -->
        <mxCell id="f_start" value="시작" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="f_wc1" value="웹캠 프레임 취득&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;640×640 / 30fps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="f_wc2" value="YOLOv11n 추론&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;/webcam/annotated 발행&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="f_d1" value="Car 감지?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="f_wc3" value="감지결과 · 엣지 트리거 발행&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;/webcam/detections, /webcam/trigger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="f_und" value="AMR 기동&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;undock · setInitialPose · AMCL 수렴&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="f_nav" value="목표 지점 이동&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Nav2 · LiDAR costmap 회피&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="f_d2" value="목표 도착 or&lt;br&gt;Car 발견?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="140" height="80" as="geometry"/></mxCell>

        <!-- Right column: onboard tracking (PC2) -->
        <mxCell id="f_on1" value="RGB(preview)+Depth 동기 취득&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;ApproximateTimeSync (slop 0.15)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="f_on2" value="YOLOv8 추론 (best.pt)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;클래스: Car / Dummy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="f_d3" value="Car 감지?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="410" y="200" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="f_on3" value="중심 거리 산출&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;패치 7→11→15 median · 유효필터 · LPF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="300" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="f_on4" value="★ 표적 좌표 변환&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;픽셀+깊이 → K⁻¹ 역투영 → TF → map 좌표&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="390" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="f_on5" value="목표 접근 (cmd_vel)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;map 좌표 go-to-point · 정렬→전진&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="480" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="f_d4" value="거리 ≤ 0.35 m?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="405" y="570" width="130" height="80" as="geometry"/></mxCell>
        <mxCell id="f_on6" value="정지 및 도달 알림&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;/approach/status (arrived)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="680" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="f_end" value="종료" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="410" y="760" width="120" height="40" as="geometry"/></mxCell>

        <!-- edges left -->
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_start" target="f_wc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_wc1" target="f_wc2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_wc2" target="f_d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe4" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f_d1" target="f_wc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe5" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_d1" target="f_wc3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_wc3" target="f_und"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_und" target="f_nav"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_nav" target="f_d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe9" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f_d2" target="f_nav"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe10" value="예 (Car 발견 → 추적 전환)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="f_d2" target="f_on5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- edges right -->
        <mxCell id="fe11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_on1" target="f_on2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_on2" target="f_d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe13" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f_d3" target="f_on1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe14" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_d3" target="f_on3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_on3" target="f_on4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_on4" target="f_on5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_on5" target="f_d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe18" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="f_d4" target="f_on5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe19" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="f_d4" target="f_on6"><mxGeometry relative="1" as="geometry"/></mxCell>
